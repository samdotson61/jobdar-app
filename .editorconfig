# Jobdar — editor defaults so every session writes the same shape (1.70.1). The code is plain ESM with
# no semicolons, single quotes and two-space indents; no formatter is run over the tree (a repo-wide
# reflow would collide with the other sessions working it), so the editor carries the convention.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
